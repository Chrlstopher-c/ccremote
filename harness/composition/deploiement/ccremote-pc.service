# Unité systemd --user du process PC (H-75).
#
# Installation (sur le PC) :
#   mkdir -p ~/.config/systemd/user
#   sed 's#%h/ccremote/harness#/mnt/projects/ccremote/harness#g' ccremote-pc.service \
#     > ~/.config/systemd/user/ccremote-pc.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now ccremote-pc.service
#   loginctl enable-linger <utilisateur>   # démarre le service SANS session graphique ouverte
#
# `☠` LE `sed` N'EST PAS OPTIONNEL SUR LE PC, et l'oublier casse le service en
# silence de démarrage : `%h/ccremote` n'existe pas ici, le dépôt vit dans
# `/mnt/projects/ccremote`. Copié tel quel (ce que disait cette notice avant le
# 02/08), systemd relance en boucle sur « Module not found » — payé le jour même,
# en déployant une correction sans rapport. Le déploiement du VPS fait ce même
# `sed`, mais il est SCRIPTÉ là-bas ; ici l'installation est manuelle.
#
# `☠` Ne PAS ajouter de commande d'arrêt qui fait `pkill`/`kill` par motif
# générique (`bun`, `node`…) — incident réel déjà payé sur ce parc, un motif
# générique a tué un service tiers sans rapport. `systemctl --user stop`
# envoie SIGTERM au PID exact qu'il connaît lui-même ; `bin-pc.ts` gère
# SIGTERM proprement (voir le handler `arreterProprement`) — rien d'autre à
# ajouter ici.
#
# Le secret et l'URL du Pi vivent dans un fichier `.env` chargé par
# `EnvironmentFile=`, jamais dans cette unité versionnée (jamais de secret en
# clair dans un fichier suivi par git).

[Unit]
# `☠` ICI, dans [Unit] — pas dans [Service], où systemd l'ignore en le disant
# (« Unknown key », vu dans le journal du Pi le 02/08). Mal placée, la clé ne
# désarmait RIEN : un service qui échoue vite cinq fois se serait retrouvé en
# `failed` définitif, exactement ce que ce réglage existe pour empêcher.
StartLimitIntervalSec=0
Description=ccremote — process PC (harness Bun, H-75 : client du lien Pi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/ccremote/pc.env
ExecStart=/usr/bin/env bun run %h/ccremote/harness/composition/pc/bin-pc.ts
Restart=always
# `☠` 60 s, pas 10. Le transport traite un refus d'authentification (4401)
# comme TERMINAL — précisément pour ne pas marteler le Pi avec un mauvais
# secret. Relancer le process toutes les 10 s annulait ce garde-fou à
# l'assemblage : le martèlement revenait par la porte de systemd. À 60 s, un
# secret erroné coûte une tentative par minute et se répare tout seul dès que
# la configuration est corrigée, sans intervention manuelle.
RestartSec=60
# Jamais de mise en échec définitive de l'unité : l'exigence est « tout se
# reconnecte tout seul le lendemain ». Un service arrêté net obligerait à
# ouvrir un SSH depuis un téléphone — l'erreur coûte bien plus cher dans ce
# sens que dans l'autre.
# Backoff de reconnexion RÉSEAU déjà géré par `client-lien-pi.ts` (gigue
# comprise) — `RestartSec` ne couvre que le redémarrage du PROCESS.
#
# Codes de sortie (voir `bin-pc.ts`) : 78 = configuration fausse (secret
# absent ou refusé, variable manquante), 1 = plantage. `systemctl --user
# status ccremote-pc` les distingue sans ouvrir le journal.

[Install]
WantedBy=default.target
