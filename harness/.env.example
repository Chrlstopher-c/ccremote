# Variables de composition — voir composition/env.ts pour la lecture stricte.
# Aucune valeur sensible n'est codée en dur dans le code : tout ce qui suit
# doit être défini dans l'environnement réel de chaque process (Pi / PC).

# ─────────────────────────────────────────────────────────────────────────
# Commun
# ─────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────
# Lien Pi↔PC (H-75) — le Pi HÉBERGE, le PC INITIE. Secret partagé entre les
# deux process, obligatoire des deux côtés, jamais journalisé.
# ─────────────────────────────────────────────────────────────────────────
# Obligatoire des DEUX côtés (Pi et PC) — même valeur. Génère avec, par ex. :
#   openssl rand -hex 32
CCREMOTE_LIEN_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Process PC (composition/pc/bin-pc.ts) — superviseur de workers
# ─────────────────────────────────────────────────────────────────────────
# Obligatoire. Fichier SQLite de persistance du registre de workers (dette n°1).
CCREMOTE_PC_REGISTRE_DB=/var/lib/ccremote/pc/registre-workers.sqlite

# Obligatoire. `ws://` (LAN direct) ou `wss://` (via Cloudflare Tunnel) du Pi,
# SANS le secret (ajouté automatiquement par `client-lien-pi.ts`).
CCREMOTE_LIEN_URL_PI=wss://ccremote.exemple.com/lien-pc

# ─────────────────────────────────────────────────────────────────────────
# Process Pi (composition/pi/bin-pi.ts) — control plane
# ─────────────────────────────────────────────────────────────────────────
# Obligatoire. Fichier SQLite du registre (E.1, missions/comptes/quotas).
CCREMOTE_PI_REGISTRE_DB=/var/lib/ccremote/pi/registre.sqlite
# Obligatoire. Fichier JSON d'identité de session de l'orchestrateur (A.1.2).
CCREMOTE_PI_IDENTITE_ORCHESTRATEUR=/var/lib/ccremote/pi/identite-orchestrateur.json
# Obligatoire. Fichier JSONL des incidents orchestrateur (H-60).
CCREMOTE_PI_INCIDENTS_ORCHESTRATEUR=/var/lib/ccremote/pi/incidents-orchestrateur.jsonl
# Obligatoire. Répertoire racine des projets déclarés (branche F).
CCREMOTE_PI_REPERTOIRE_PROJETS=/var/lib/ccremote/pi/projets

# Optionnel. cwd de la session orchestrateur. Défaut : process.cwd().
CCREMOTE_PI_CWD_ORCHESTRATEUR=/var/lib/ccremote/pi
# Optionnel. Racine des pièces jointes des messages (migration 24). Défaut :
# `<CCREMOTE_PI_CWD_ORCHESTRATEUR>/pieces-jointes` — sous le cwd à dessein, c'est
# ce qui garantit que le `Read` de l'orchestrateur atteint le fichier.
# ☠ Si tu la déplaces, exclue le nouveau chemin du rsync de `deploy-harness-pi.sh` :
# `--delete` effacerait toutes les captures à chaque déploiement.
CCREMOTE_PI_PIECES_JOINTES=/var/lib/ccremote/pi/pieces-jointes
# Optionnel. CLAUDE_CONFIG_DIR du compte utilisé par l'orchestrateur (H-53).
CCREMOTE_PI_CONFIG_DIR_ORCHESTRATEUR=/home/trinity/.claude-comptes/compte-a

# Port d'écoute LOCAL du lien Pi↔PC (H-75 — le Pi héberge). Défaut : 8721.
# Le Cloudflare Tunnel existant (voir README.md) relaie `/lien-pc` vers ce
# port en local — ce port lui-même reste sur l'interface loopback.
CCREMOTE_LIEN_PORT=8721
# Interface d'écoute locale. Défaut : 127.0.0.1 — seul le tunnel Cloudflare
# doit être exposé publiquement, jamais ce port directement sur le LAN/WAN.
CCREMOTE_LIEN_HOST=127.0.0.1

# Port de l'API web lue par `pi-web` (Flask), qui la relaie sous
# `/api/harness/...`. Défaut : 8722.
# `☠` Toujours en loopback : cette API n'a AUCUNE authentification propre, elle
# s'appuie entièrement sur la session de pi-web. Le serveur REFUSE de démarrer
# sur une interface publique plutôt que de laisser passer la configuration.
CCREMOTE_API_WEB_PORT=8722

# Optionnel. Seuil (0-100) du plafond de parc (G.1.3). Absent = plafond désactivé
# (comportement historique H-58 : « codé, sans seuil par défaut »).
CCREMOTE_PLAFOND_PARC_SEUIL_PCT=90
