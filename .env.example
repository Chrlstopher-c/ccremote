# Charge depuis pi-web/.env. Aucune coordonnée réelle n'est codée en dur dans le
# dépôt : hôtes, MAC, cibles SSH et identifiants viennent tous de l'environnement,
# les valeurs présentes dans le code ne sont que des placeholders inertes.

CEREBRAS_API_KEY=
CEREBRAS_API_KEY_2=
# CEREBRAS_API_KEY_2 est optionnelle : si absente, pas de rotation, une seule clé utilisée.
UI_PASSWORD=

# ─── Coordonnées réseau (aucune valeur réelle dans le dépôt) ───────────────
# Défauts inertes : `pc.exemple`, `pi.exemple`, `aa:bb:cc:dd:ee:ff`.
CCREMOTE_PC_HOST=
CCREMOTE_PC_PORT=8765
CCREMOTE_PC_MAC=
CCREMOTE_PC_USER=
CCREMOTE_PI_HOST=
CCREMOTE_PI_USER=
CCREMOTE_PC_SSH_PORT=22
# Cible SSH et clé utilisées par les scripts de déploiement.
CCREMOTE_PI_CIBLE=
CCREMOTE_VPS_CIBLE=
CCREMOTE_SSH_KEY=
# Identifiant de connexion de l'UI pi-web (défaut : `operateur`).
UI_USER=
