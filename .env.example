# Charge depuis pi-web/.env (seul composant avec des secrets — server/ et client/
# n'ont que des constantes réseau non sensibles codées en dur dans leurs config.py).

CEREBRAS_API_KEY=
CEREBRAS_API_KEY_2=
# CEREBRAS_API_KEY_2 est optionnelle : si absente, pas de rotation, une seule clé utilisée.
UI_PASSWORD=
