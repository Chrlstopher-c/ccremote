# ccremote — configuration.
# Copier en `.env` à la racine (lu par docker compose) et remplir.

# ── Interface web ─────────────────────────────────────────────────────────────
UI_USER=chris
UI_PASSWORD=

# ── Modèles ───────────────────────────────────────────────────────────────────
# L'agent parle OpenAI : n'importe quel serveur compatible convient. Par défaut il vise
# EchoHub sur l'hôte, qui sert les modèles locaux.
#
# Depuis un conteneur, `localhost` désigne le conteneur lui-même — d'où host.docker.internal,
# résolu vers l'hôte par l'entrée extra_hosts du compose.
AGENT_BASE_URL=http://host.docker.internal:37821/v1

# Ignorée par les serveurs locaux, mais le SDK OpenAI refuse de démarrer sans clé.
# À remplir uniquement pour viser un fournisseur distant.
AGENT_API_KEY=local
AGENT_API_KEY_2=

# Vide = le premier modèle annoncé par /v1/models est retenu, c'est-à-dire celui qui est
# réellement chargé à cet instant. À ne fixer que pour imposer un modèle précis.
AGENT_MODEL=

# Fenêtre de contexte supposée quand le serveur ne l'annonce pas.
AGENT_CONTEXT_FALLBACK=32000

# ── PC piloté ─────────────────────────────────────────────────────────────────
# Adresse MAC pour le réveil Wake-on-LAN. Vide = fonction indisponible.
PC_MAC=
