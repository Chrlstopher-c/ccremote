# Relais (Pi) — valeurs réelles dans /mnt/hdd/ccremote/relais.env (600), jamais versionnées.
CCREMOTE_EMPREINTE_MOT_DE_PASSE=   # bun -e "console.log(await Bun.password.hash('…'))", entre apostrophes
CCREMOTE_SECRETS_POSTES=           # machine=secret,machine=secret (un secret par poste)
CCREMOTE_MACHINES_ISOLEES=vps      # machines qui ne joignent pas la maison
CCREMOTE_WOL=                      # machine=aa:bb:cc:dd:ee:ff (réveil à distance)
CCREMOTE_DIFFUSION_WOL=            # adresse de diffusion du LAN
CCREMOTE_BASE=                     # chemin de la base SQLite (défaut : .donnees/relais.db)
CCREMOTE_WEB=                      # dossier de l'interface construite (défaut : bureau/dist)
CCREMOTE_PORT_WEB=8766
CCREMOTE_PORT_POSTES=8721
CCREMOTE_ORIGINES=                 # origines CORS autorisées (défaut : Tauri + Vite)

# Poste — ~/.config/ccremote/poste.env ; le reste dans ~/.config/ccremote/poste.json
CCREMOTE_SECRET_POSTE=
