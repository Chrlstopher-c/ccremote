{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quart",
  "version": "2.0.0",
  "identifier": "com.echo.ccremote",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quart",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#1E1830"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
