# Source des données du monde : demo (défaut, sans relais) ou relais.
VITE_SOURCE=demo
# Adresse du relais vue par le navigateur. En dev, pointer sur le serveur Vite (ex. http://127.0.0.1:5190) :
# il proxifie /api vers RELAIS_CIBLE, sans CORS. Le jeton d'accès est saisi dans le navigateur (clé agent-hq.jeton).
VITE_RELAIS_URL=http://127.0.0.1:5190
# Cible du proxy de dev, côté serveur seulement (jamais exposée au bundle).
RELAIS_CIBLE=https://relais.example.com
